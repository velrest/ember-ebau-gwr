<UkModal
  @visible={{@visible}}
  @btnClose={{false}}
  @escClose={{false}}
  @bgClose={{false}}
  @on-hide={{@close}}
  @container={{this.config.modalContainer}}
  as |Modal|
>
  <Modal.header>
    <h2 class="uk-modal-title">
      {{t "ember-gwr.components.importModal.selectImportData"}}
    </h2>
  </Modal.header>
  <Modal.body class="uk-overflow-auto">
    <ImportModal::List
      @data={{@import.originalData}}
      @close={{@close}}
      @title={{t "ember-gwr.models.building" count=1}}
      @dataComponent={{concat "import-modal/" @modelName "-data"}}
    />

  </Modal.body>
  <Modal.footer>
    <LinkTo
      @query={{hash import=false index=undefined}}
      class="uk-button uk-button-default uk-width-1"
      {{on "click" @close}}
    >
      {{t "ember-gwr.components.modelForm.cancelImport"}}
    </LinkTo>
  </Modal.footer>
</UkModal>
